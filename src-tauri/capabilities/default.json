{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Ce dont la fenêtre principale a besoin : l'IPC vers les commandes Rust, et l'ouverture des profils GitHub dans le navigateur du système.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/*" }]
    }
  ]
}
